# ─────────────────────────────────────────────
#  THE KARTAVYA MOVEMENT — Backend Environment
# ─────────────────────────────────────────────
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.

# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:4200,https://thekartavyamovement.org

# ── MySQL Database ─────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kartavya_movement
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_CONNECTION_LIMIT=10

# ── Email (SMTP) ───────────────────────────────
# For Gmail: use an App Password (not your main password).
# Enable 2FA on your Google account, then generate an App Password at:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=thekartavyamovement@gmail.com
SMTP_PASS=pwvf stvs tylo deht

# Recipients — both addresses receive every enquiry notification
NOTIFY_EMAIL_1=connect@thekartavyamovement.org
NOTIFY_EMAIL_2=thekartavyamovement@gmail.com

# The "From" address shown in notification emails
FROM_EMAIL="The Kartavya Movement <thekartavyamovement@gmail.com>"
