# ─────────────────────────────────────────────────────────────────────────────
#  THE KARTAVYA MOVEMENT — Backend Environment
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:4200,https://thekartavyamovement.org

# ── Database driver ───────────────────────────────────────────────────────────
# Switch between databases with a single variable.
#   mysql    → uses MySQL  (mysql2 driver)  — default
#   postgres → uses PostgreSQL (pg driver)
#
DB_DRIVER=mysql

# ─────────────────────────────────────────────────────────────────────────────
#  MYSQL CONFIGURATION  (used when DB_DRIVER=mysql)
# ─────────────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kartavya_movement
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_CONNECTION_LIMIT=10

# ─────────────────────────────────────────────────────────────────────────────
#  POSTGRESQL CONFIGURATION  (used when DB_DRIVER=postgres)
#
#  Option A — single connection string (Render, Supabase, Railway, Neon, etc.)
#             This takes priority over individual DB_* vars below.
# DATABASE_URL=postgresql://user:password@host:5432/kartavya_movement
#
#  Option B — individual variables (local Postgres, custom VPS)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=kartavya_movement
# DB_USER=your_pg_user
# DB_PASSWORD=your_pg_password
# DB_CONNECTION_LIMIT=10
# DB_SSL=false         # set to true if your provider requires SSL without a full URL
# ─────────────────────────────────────────────────────────────────────────────

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# For Gmail: use an App Password, NOT your account password.
# Steps: enable 2FA → https://myaccount.google.com/apppasswords → create app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=thekartavyamovement@gmail.com
SMTP_PASS=your_gmail_app_password

# Recipients — both addresses receive every enquiry notification email
NOTIFY_EMAIL_1=connect@thekartavyamovement.org
NOTIFY_EMAIL_2=thekartavyamovement@gmail.com

# The "From" name/address shown in sent emails
FROM_EMAIL="The Kartavya Movement <thekartavyamovement@gmail.com>"
